{
    "name": "rindow/rindow-qubit",
    "description": "PHP port of Qiskit core (QuantumCircuit + StatevectorSampler + visualization) under Rindow\\Qubit namespace",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "rindow/rindow-math-matrix": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5",
        "rindow/rindow-math-matrix-matlibffi": "^1.1"
    },
    "suggest": {
        "rindow/rindow-math-matrix-matlibffi": "^1.1: For Multithreading/GPU support"
    },
    "autoload": {
        "psr-4": {
            "Rindow\\Qubit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RindowTest\\Qubit\\": "tests/RindowTest/Qubit/"
        }
    },
    "scripts": {
        "test": "phpunit -c tests/phpunit.xml"
    }
}